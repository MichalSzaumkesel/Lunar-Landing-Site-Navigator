# Force mock data for every site (synthetic badge everywhere).
VITE_USE_MOCK=0

# Optional on-demand custom-site service (api/). If it is unreachable the app
# falls back to the client-side approximation (approximate = true).
VITE_API_URL=http://localhost:8000

# Public base path. "/" for Vercel and local, "/<repo>/" for GitHub Pages.
VITE_BASE=/
